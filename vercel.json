{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/vite"
    }
  ],
  "rewrites": [
    {
      "source": "/api/products/:path*",
      "destination": "backend/index.js"
    },
    {
      "source": "/auth/:path*",
      "destination": "backend/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/index.html"
    }
  ]
}
